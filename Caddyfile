{
	admin off
	auto_https off
	# cloudflared (a private address) is the trusted hop; CF-Connecting-IP carries the real client.
	# A client on the LAN is trusted too and could name its own address: acceptable at home.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} {path}.html /app.html
		file_server
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'"
	}
}
