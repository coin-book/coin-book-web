{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    ".svelte-kit/types/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.svelte"
  ],
  "exclude": ["../../packages/**/*.test.ts"]
}
